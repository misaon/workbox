{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "rules": {
    "no-restricted-globals": [
      "error",
      { "name": "Bun", "message": "protocol must stay runtime-neutral" },
      { "name": "process", "message": "protocol must stay runtime-neutral" }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          { "group": ["bun:*", "node:*"], "message": "protocol must stay runtime-neutral" }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun:test",
                "importNames": ["xdescribe", "xit", "xtest"],
                "message": "xdescribe, xit and xtest skip tests silently and Bun still exits 0 (jest/no-disabled-tests cannot see bun:test imports, so this rule guards them); use test.skipIf(condition) with a stated reason instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
