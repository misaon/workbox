{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": { "typeAware": true },
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/paraglide/**", "**/coverage/**"],
  "rules": {
    "no-console": "error",
    "import/no-default-export": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "unicorn/prefer-node-protocol": "error",
    "typescript/no-explicit-any": "error",
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    "func-style": ["error", "declaration", { "allowArrowFunctions": true }],
    "id-length": ["error", { "exceptions": ["z"] }],
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "one-var": ["error", "never"],
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/no-named-export": "off",
    "import/no-nodejs-modules": "off",
    "import/prefer-default-export": "off",
    "no-ternary": "off",
    "sort-imports": "off",
    "sort-keys": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": ["jest"],
      "rules": {
        "jest/no-disabled-tests": "error",
        "jest/no-focused-tests": "error",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "no-magic-numbers": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun:test",
                "importNames": ["xdescribe", "xit", "xtest"],
                "message": "xdescribe, xit and xtest skip tests silently and Bun still exits 0 (jest/no-disabled-tests cannot see bun:test imports, so this rule guards them); use test.skipIf(condition) with a stated reason instead."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "describe",
            "property": "only",
            "message": "A committed .only hides the rest of the suite (jest/no-focused-tests cannot see bun:test imports, so this rule guards them)."
          },
          {
            "object": "describe",
            "property": "skip",
            "message": "A committed .skip silently stops testing (jest/no-disabled-tests cannot see bun:test imports, so this rule guards them)."
          },
          {
            "object": "it",
            "property": "only",
            "message": "A committed .only hides the rest of the suite (jest/no-focused-tests cannot see bun:test imports, so this rule guards them)."
          },
          {
            "object": "it",
            "property": "skip",
            "message": "A committed .skip silently stops testing (jest/no-disabled-tests cannot see bun:test imports, so this rule guards them)."
          },
          {
            "object": "test",
            "property": "only",
            "message": "A committed .only hides the rest of the suite (jest/no-focused-tests cannot see bun:test imports, so this rule guards them)."
          },
          {
            "object": "test",
            "property": "skip",
            "message": "A committed .skip silently stops testing (jest/no-disabled-tests cannot see bun:test imports, so this rule guards them)."
          }
        ]
      }
    },
    {
      "files": ["**/*.config.ts", "**/*.config.js", "**/*.config.mjs"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      "files": ["apps/web/**/*.tsx", "apps/web/**/*.ts"],
      "plugins": ["react", "jsx-a11y"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
      }
    },
    {
      "files": ["apps/web/**/*.test.tsx", "apps/web/**/*.test.ts"],
      "plugins": ["vitest"],
      "rules": { "vitest/no-importing-vitest-globals": "off" }
    },
    {
      "files": ["apps/cli/src/output/**"],
      "rules": { "no-console": "off" }
    }
  ]
}
